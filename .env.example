# MongoDB Atlas Cloud Database Connection String
# Replace YOUR_USERNAME, YOUR_PASSWORD, and YOUR_CLUSTER with your actual Atlas cluster details.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/food_management_db?retryWrites=true&w=majority
PORT=5000

# Neo4j Graph Database (AuraDB or local)
# Get free AuraDB at: https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=neo4j+s://neo4j+s://a9f33597.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
